@page "/"
@rendermode InteractiveServer

<PageTitle>Kimberlin Viado | Product Designer</PageTitle>

<style>
  .page-shell { min-height: 720px; padding-top: 18px; }
  .site-header { width: min(850px, 100%); min-height: 52px; border-radius: 15px; padding-left: 20px; }
  .brand { font-size: 22px; }
  .nav-links { gap: 28px; margin-left: 50px; }
  .nav-links a, .contact-button { font-size: 11px; }
  .contact-button { padding: 11px 14px; border-radius: 10px; }
  .intro { width: min(600px, 100%); margin-bottom: 10px; }
  .portrait { transform: scale(.54); margin-bottom: -45px; }
  .intro-copy h1 { font-size: 36px; letter-spacing: -1px; }
  .intro-copy .role { margin: 9px 0 7px; font-size: 12px; }
  .summary { max-width: 410px; font-size: 11px; line-height: 1.45; }
  .projects-section, .about-section, .resume-section { padding: 78px max(6vw, 24px); }
  .section-heading { max-width: 850px; margin-bottom: 28px; }
  .section-heading h2, .about-section h2, .resume-section h2 { font-size: 42px; letter-spacing: -1px; }
  .project-grid { max-width: 850px; gap: 14px; }
  .project-art, .project-card-wide .project-art { min-height: 180px; }
  .project-art img { display: block; width: 100%; height: 100%; min-height: inherit; object-fit: cover; filter: saturate(.88); }
  .project-info { padding: 13px 2px 20px; }
  .project-info h3 { font-size: 18px; }
  .project-info > p { font-size: 11px; }
  .project-type { font-size: 8px; }
  .about-copy { font-size: 13px; }
  .resume-section footer { margin-top: 70px; }
  @@media (max-width: 680px) { .nav-links { gap: 16px; margin-left: 0; } .intro-copy h1 { font-size: 34px; } .project-grid { gap: 0; } }
</style>

<main class="page-shell" id="top">
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Kimberlin Viado home"><span class="brand-k">K</span><span class="brand-dot">.</span></a>
    <nav class="nav-links" aria-label="Main navigation">
      <a href="#projects">Projects</a>
      <a href="#about">About me</a>
      <a href="#resume">Resume</a>
    </nav>
    <a class="contact-button" href="mailto:hello@kimberlinviado.com">Get in touch <span aria-hidden="true">↗</span></a>
  </header>

  <section class="intro" aria-labelledby="intro-title">
    <div class="portrait" aria-label="Illustration of Kim" role="img">
      <div class="portrait-hair"></div><div class="portrait-face"><span class="ear ear-left"></span><span class="ear ear-right"></span><span class="eye eye-left"></span><span class="eye eye-right"></span><span class="nose"></span><span class="mouth"></span><span class="blush blush-left"></span><span class="blush blush-right"></span></div><div class="portrait-locks locks-left"></div><div class="portrait-locks locks-right"></div>
    </div>
    <div class="intro-copy">
      <h1 id="intro-title"><span class="wave">👋</span> Hi there, I’m Kim<span class="accent">!</span></h1>
      <p class="role">Product Designer</p>
      <p class="summary">I love turning complex problems into simple, intuitive digital experiences through research, strategy, and thoughtful product design.</p>
    </div>
  </section>
  <div class="scroll-cue" aria-hidden="true"><span>scroll to explore</span><b>↓</b></div>
</main>

<section class="projects-section" id="projects" aria-labelledby="projects-title">
  <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2 id="projects-title">20 Projects</h2></div><span class="section-number">✦</span></div>
  <div class="project-grid">
    <article class="project-card project-card-wide"><div class="project-art"><img src="https://images.unsplash.com/photo-1558655146-d09347e92766?auto=format&fit=crop&w=900&q=85" alt="Colorful interface designs on a desk" loading="lazy" /></div><div class="project-info"><div><p class="project-type">01 · Product Design</p><h3>Chatty</h3></div><span class="round-arrow">↗</span><p>Making conversations feel a little more human.</p></div></article>
    <article class="project-card"><div class="project-art"><img src="https://images.unsplash.com/photo-1545235617-9465d2a55698?auto=format&fit=crop&w=700&q=85" alt="Mobile app interface sketches" loading="lazy" /></div><div class="project-info"><div><p class="project-type">02 · Mobile App</p><h3>Kindle Read</h3></div><span class="round-arrow">↗</span><p>A calmer way to keep your reading habit close.</p></div></article>
    <article class="project-card"><div class="project-art"><img src="https://images.unsplash.com/photo-1559028012-481c04fa702d?auto=format&fit=crop&w=700&q=85" alt="Digital product dashboard" loading="lazy" /></div><div class="project-info"><div><p class="project-type">03 · Web Experience</p><h3>Social Studio</h3></div><span class="round-arrow">↗</span><p>Helping teams make space for better ideas.</p></div></article>
  </div>
  <a class="all-projects" href="#about">View all projects <span>↗</span></a>
</section>

<section class="about-section" id="about" aria-labelledby="about-title"><div><p class="eyebrow">A bit about me</p><h2 id="about-title">Curious by nature,<br /><span>thoughtful by design.</span></h2></div><div class="about-copy"><p>I'm a product designer who enjoys finding the sweet spot between what people need and what businesses need to grow.</p><p>When I'm not designing, you'll find me collecting little bits of inspiration, making playlists, or looking for a good cup of coffee.</p><a class="text-link" href="mailto:hello@kimberlinviado.com">Let's talk <span>↗</span></a></div></section>

<section class="resume-section" id="resume" aria-labelledby="resume-title"><p class="eyebrow">Have a project in mind?</p><h2 id="resume-title">Let's make something<br /><span>useful together.</span></h2><a class="contact-button large" href="mailto:hello@kimberlinviado.com">Get in touch <span aria-hidden="true">↗</span></a><footer><span>© 2024 Kimberlin Viado</span><span>Designed with intention.</span><a href="#top">Back to top ↑</a></footer></section>
